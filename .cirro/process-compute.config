params{
    wes = false
    trim_fastq = false
    clip_r1 = 0
    clip_r2 = 0
    three_prime_clip_r1 = 0
    three_prime_clip_r2 = 0
    trim_nextseq = false
    save_trimmed = false
    genome = null
    intervals = null
    validationSchemaIgnoreParams = "compute_multiplier"
    save_output_as_bam = true
    save_mapped = true

    max_memory                 = 488.GB
    max_cpus                   = 64
    max_time                   = 240.h
}

process{

    errorStrategy = 'retry'
    maxRetries = 5

    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    withLabel:process_low {
        cpus         = { 2 * task.attempt }
        memory       = { 15.GB * task.attempt }
        time         = { 24.h }
    }
    withLabel:process_medium {
        cpus         = { 4 * params.compute_multiplier * task.attempt }
        memory       = { 30.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h }
    }
    withLabel:process_high {
        cpus         = { 8 * params.compute_multiplier * task.attempt }
        memory       = { 60.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h * params.compute_multiplier }
    }
    withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        cpus         = { 16 * params.compute_multiplier * task.attempt }
        memory       = { 120.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h * params.compute_multiplier }
    }
    withName: 'PARABRICKS_FQ2BAM' {
        accelerator   = 4
        cpus          = { 16 * params.compute_multiplier * task.attempt }
        memory        = { 150.GB * params.compute_multiplier * task.attempt }
        time          = { 24.h * params.compute_multiplier }
        queue         = env('PW_ONDEMAND_JOB_QUEUE')
        // Extends, not replaces, sarek's own publishDir for this process (see git history).
        publishDir    = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/preprocessing/parabricks/${meta.id}/" },
                pattern: "*{cram,crai,bam,bai}",
                saveAs: { filename -> ((params.skip_tools && params.skip_tools.split(',').contains('baserecalibrator')) && params.save_mapped && (meta.size * meta.num_lanes == 1)) ? filename : null }
            ],
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/preprocessing/parabricks/${meta.id}/" },
                pattern: "*.table",
            ]
        ]
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
        maxRetries    = 2
        // Extends, not replaces, sarek's own ext.args for this process (see git history).
        ext.args      = { [
            "--read-group-id-prefix ${meta.sample_lane_id}",
            "--read-group-sm ${meta.patient}_${meta.sample}",
            "--read-group-lb ${meta.sample}",
            "--read-group-pl ${params.seq_platform}",
            meta.status == 1 ? "--bwa-options='-K 100000000 -Y -B 3'" : "--bwa-options='-K 100000000 -Y'",
            "--gpuwrite",
            "--gpusort",
            "--low-memory",
        ].join(' ').trim() }
    }
    withName: 'PARABRICKS_APPLYBQSR' {
        accelerator   = 1
        queue         = env('PW_ONDEMAND_JOB_QUEUE')
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
        maxRetries    = 2
    }
    withName:'GATK4_APPLYBQSR_SPARK|GATK4_BASERECALIBRATOR|GATK4_GATHERBQSRREPORTS'{
        cpus         = { 2 * params.compute_multiplier * task.attempt }
        memory       = { 16.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h * params.compute_multiplier }
    }
    withName: 'GATK4_APPLYBQSR'{
        cpus         = { 2 * params.compute_multiplier * task.attempt }
        memory       = { 16.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h * params.compute_multiplier }
        queue        = env('PW_ONDEMAND_JOB_QUEUE')
    }
    withName: 'GATK4_MARKDUPLICATES|BAM_MARKDUPLICATES'{
        cpus         = { 16 * params.compute_multiplier * task.attempt }
        memory       = { 120.GB * params.compute_multiplier * task.attempt }
        time         = { 48.h * params.compute_multiplier }
        queue        = env('PW_ONDEMAND_JOB_QUEUE')
        // Extends, not replaces, sarek's own ext.args for this process (see git history).
        ext.args     = { [
            "--REMOVE_DUPLICATES false",
            "--VALIDATION_STRINGENCY LENIENT",
            params.save_output_as_bam ? "--CREATE_INDEX true" : '',
            params.optical_duplicate_pixel_distance ? "--OPTICAL_DUPLICATE_PIXEL_DISTANCE ${params.optical_duplicate_pixel_distance}" : '',
            params.umi_tag ? "--BARCODE_TAG ${params.umi_tag}" :
                (params.umi_in_read_header || params.umi_length ? "--BARCODE_TAG RX" : "")
        ].join(" ").trim() }
    }
    withName: 'FREEBAYES|SAMTOOLS_STATS|SAMTOOLS_INDEX|UNZIP' {
        cpus         = { 4 * params.compute_multiplier * task.attempt }
        memory       = { 30.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h }
    }
    withName: 'FASTQC' {
        cpus         = { 4 * params.compute_multiplier * task.attempt }
        memory       = { 30.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h }
    }
}

docker.registry       = 'quay.io'
apptainer.registry  = 'quay.io'
